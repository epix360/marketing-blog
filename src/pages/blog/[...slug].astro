---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { getImageInfo } from '../../lib/imageUtils';
import { formatDate } from '../../lib/formatDate';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post: CollectionEntry<'blog'>) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post }: Props = Astro.props;
const { Content } = await render(post);
const imageInfo = getImageInfo(post.data.postImage);
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	image={post.data.postImage}
	type="article"
	tags={post.data.tags}
	publishedDate={post.data.pubDate}
>
	<article>
		<header class="post-header">
			{imageInfo.src && (
			imageInfo.isPublic ? (
				<img
					src={imageInfo.src}
					alt={post.data.title}
					loading="eager"
					class="header-image"
				/>
			) : (
				<Image
					src={imageInfo.src}
					alt={post.data.title}
					width={400}
					height={400}
					format="webp"
					quality={80}
					loading="eager"
					class="header-image"
				/>
			)
		)}

			<div class="header-content">
				<h1>{post.data.title}</h1>
				<p><em>{post.data.description}</em></p>
				<time datetime={post.data.pubDate.toISOString()}>
					Published on {formatDate(post.data.pubDate)}
				</time>
				{post.data.tags && post.data.tags.length > 0 && (
					<p>
						<strong>Tags:</strong> {post.data.tags.join(', ')}
					</p>
				)}
			</div>
		</header>

		<div class="post-content" data-pagefind-body>
			<Content />
		</div>

		<footer>
			<p>
				<a href={`${import.meta.env.BASE_URL}blog/`}>← Back to Blog</a>
			</p>
		</footer>
	</article>
</BaseLayout>

<style>
	.post-header {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 1.5rem;
		margin-bottom: 2rem;
	}

	:global(.header-image) {
		max-width: 100%;
		width: 400px;
		height: 400px;
		object-fit: cover;
		border-radius: 8px;
		flex-shrink: 0;
	}

	.header-content {
		flex: 1;
		min-width: 0;
		text-align: left;
		max-width: 100%;
	}

	.header-content h1 {
		margin-top: 0;
	}

	/* Mobile: stack vertically with centered content (Pico's breakpoint at 768px) */
	@media (max-width: 768px) {
		.post-header {
			flex-direction: column;
			align-items: center;
		}

		:global(.header-image) {
			width: 100%;
			max-width: 300px;
			height: auto;
			aspect-ratio: 1;
		}

		.header-content {
			width: 100%;
			text-align: center;
		}
	}
</style>
