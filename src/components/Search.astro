---
// Search.astro - Global search component using Pagefind
---

<div id="search-container">
	<label for="search-input" class="visually-hidden">Search:</label>
	<input
		type="search" 
		id="search-input" 
		placeholder="Search blog posts..."
		autocomplete="off"
	/>
	<div id="search-results" style="display: none;">
		<!-- Search results will be populated here -->
	</div>
</div>

<script is:inline>
	async function loadPagefind() {
		const searchInput = document.getElementById('search-input');
		const searchResults = document.getElementById('search-results');

		if (!searchInput || !searchResults) return;

		function renderResults(results) {
			if (results.length === 0) {
				searchResults.innerHTML = '<p style="padding: 0.5rem;">No results found.</p>';
			} else {
				searchResults.innerHTML = results.map(r => `
					<div style="margin-bottom: 1rem; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;">
						<h4 style="margin: 0 0 0.25rem 0;">
							<a href="${r.url}" style="text-decoration: none; color: inherit;">${r.title || r.url}</a>
						</h4>
						<p style="margin: 0; font-size: 0.875rem; color: #999; font-style: italic; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.4;">
							${r.excerpt || r.url}
						</p>
					</div>
				`).join('');
			}
			searchResults.style.display = 'block';
		}

		function setupSearchListeners(searchFn) {
			let searchTimeout;

			searchInput.addEventListener('input', async (e) => {
				const query = e.target?.value?.trim() || '';
				clearTimeout(searchTimeout);

				if (query.length < 2) {
					searchResults.style.display = 'none';
					return;
				}

				searchTimeout = setTimeout(async () => {
					try {
						const results = await searchFn(query);
						renderResults(results);
					} catch (err) {
						console.error('Search error:', err);
						searchResults.innerHTML = '<p style="padding: 0.5rem;">Error searching.</p>';
						searchResults.style.display = 'block';
					}
				}, 300);
			});

			document.addEventListener('click', (e) => {
				if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
					searchResults.style.display = 'none';
				}
			});
		}

		const isProduction = window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1';

		if (isProduction) {
			try {
				const pagefindModule = await import(/* @vite-ignore */ '/marketing-blog/pagefind/pagefind.js');
				const pagefind = pagefindModule.default || pagefindModule;

				setupSearchListeners(async (query) => {
					const results = await pagefind.search(query);
					return await Promise.all(results.results.map(async (result) => {
						const data = await result.data();
						return {
							url: data.url,
							title: data.meta?.title,
							excerpt: data.excerpt || data.plain_excerpt || data.meta?.description
						};
					}));
				});
			} catch (err) {
				console.error('Failed to load Pagefind:', err);
			}
		} else {
			const mockResults = [
				{ url: '/marketing-blog/blog/hello-world', title: 'Hello World', excerpt: 'Welcome to my new marketing blog!' },
				{ url: '/marketing-blog/blog/digital-marketing-2026', title: 'Digital Marketing Strategies for 2026', excerpt: 'Explore the latest digital marketing trends and strategies.' },
				{ url: '/marketing-blog/blog/content-creation-tips', title: 'Content Creation Tips for Beginners', excerpt: 'Essential tips and tricks for creating engaging content.' }
			];

			setupSearchListeners(async (query) => {
				const q = query.toLowerCase();
				return mockResults.filter(r =>
					(r.title || '').toLowerCase().includes(q) ||
					(r.excerpt || '').toLowerCase().includes(q)
				);
			});
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', loadPagefind);
	} else {
		loadPagefind();
	}
</script>

<style>
	#search-container {
		position: relative;
		flex-shrink: 0;
	}
	
	@media (max-width: 767px) {
		#search-container {
			max-width: 100%;
		}
	}
	
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
	
	#search-input {
		width: 100%;
		height: 2.5rem;
		margin-bottom: 0;
		padding: 0.5rem 0.75rem;
		padding-left: 2.5rem;
		border: 1px solid #ccc;
		border-radius: 4px;
		font-size: 1rem;
		box-sizing: border-box;
	}
	
	#search-input::placeholder {
		color: #666;
	}
	
	#search-results {
		position: absolute;
		top: calc(100% + 4px);
		left: 0;
		right: 0;
		background: white;
		border: 1px solid #ccc;
		border-radius: 4px;
		max-height: 300px;
		overflow-y: auto;
		z-index: 1000;
		box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
	}
	
	#search-results a:hover {
		text-decoration: underline;
	}
</style>
